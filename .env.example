APP_NAME=ReferralFlow
APP_ENV=local
APP_KEY=
APP_CIPHER=AES-256-GCM
# Key rotation: put the OLD keys (comma separated, base64:...) here after generating a new APP_KEY. See docs/SECURITY.md.
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=http://localhost:4461
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Blind-index key for deterministic identifier matching. Optional; derived from APP_KEY when empty.
BLIND_INDEX_KEY=

# staging (default) or production. Production refuses to start without the acknowledgement below
# AND still shows the unmet go-live checklist. See docs/GO-LIVE-GATE.md. Synthetic data only.
REFERRALFLOW_MODE=staging
REFERRALFLOW_PRODUCTION_ACK=

# Antivirus hook: optional (dev) or required (blocks uploads unless a scanner is bound)
AV_MODE=optional

HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Postgres (docker-compose.yml, NOT run on the dev machine):
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=referralflow
# DB_USERNAME=referralflow
# DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log
BROADCAST_CONNECTION=log
