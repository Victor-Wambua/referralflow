{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:referralflow:schema:Communication",
 "type": "object",
 "required": [
  "resourceType",
  "id",
  "meta",
  "status",
  "about",
  "sent",
  "sender",
  "recipient",
  "payload"
 ],
 "properties": {
  "resourceType": {
   "const": "Communication"
  },
  "id": {
   "$ref": "urn:referralflow:schema:common#/$defs/Id"
  },
  "meta": {
   "$ref": "urn:referralflow:schema:common#/$defs/Meta"
  },
  "status": {
   "enum": [
    "preparation",
    "in-progress",
    "not-done",
    "on-hold",
    "stopped",
    "completed",
    "entered-in-error",
    "unknown"
   ]
  },
  "about": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "urn:referralflow:schema:common#/$defs/Reference"
   }
  },
  "sent": {
   "$ref": "urn:referralflow:schema:common#/$defs/DateTime"
  },
  "sender": {
   "$ref": "urn:referralflow:schema:common#/$defs/Reference"
  },
  "recipient": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "urn:referralflow:schema:common#/$defs/Reference"
   }
  },
  "payload": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "contentString"
    ]
   }
  }
 }
}