{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:referralflow:schema:Patient",
 "type": "object",
 "required": [
  "resourceType",
  "id",
  "meta",
  "gender"
 ],
 "properties": {
  "resourceType": {
   "const": "Patient"
  },
  "id": {
   "$ref": "urn:referralflow:schema:common#/$defs/Id"
  },
  "meta": {
   "$ref": "urn:referralflow:schema:common#/$defs/Meta"
  },
  "gender": {
   "enum": [
    "male",
    "female",
    "other",
    "unknown"
   ]
  },
  "name": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "text"
    ]
   }
  },
  "birthDate": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "identifier": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "system",
     "value"
    ]
   }
  }
 }
}